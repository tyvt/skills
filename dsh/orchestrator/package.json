{
  "name": "dsh-orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "接入 LangGraph 多模型工具编排器：一个入口工具 orchestrate，按工具路由到不同 magpie 模型池并自动故障转移。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
