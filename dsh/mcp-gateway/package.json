{
  "name": "dsh-mcp-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "按需 MCP 网关：把常驻的 MCP 工具表压成一个入口工具，首次调用时才拉起子进程。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
