: sort all events by date; within a day keep bugs grouped then tasks (but interleave by id asc for readability)\nevents=[]\nfor bid,title,pid,dt,st,proj in B:\n    h = 0.5\n    events.append(dict(dt=dt, seq=bid, kind='bug', proj=proj, zid=f'Bug{bid}', content=title,\n                       start=dt, end=dt, hours=h, ttype='BUG修复',\n                       prog=(1 if st in ('closed','resolved') else 0.5),\n                       note=('' if st in ('closed','resolved') else '进行中（待修复）')))\nfor tid,name,proj,dt,h,ttype,prog,note in T:\n    events.append(dict(dt=dt, seq=10000+tid, kind='task', proj=proj, zid=f'任务{tid}', content=name,\n                       start=dt, end=dt, hours=h, ttype=ttype, prog=prog, note=note))\nevents.sort(key=lambda e:(e['dt'], e['seq']))\n\ndef fmt_date(d):\n    return d.replace('-','/')\n\nwb = openpyxl.load_workbook(TEMPLATE)\n\n# ===== Sheet 1: 本周工作总结 =====\nws = wb['本周工作总结']\n# clear existing data rows (row 3 .. max_row)\nmaxr = ws.max_row\nfor r in range(maxr, 2, -1):\n    ws.delete_rows(r)\n# title\nws['A1'] = '研发部2026.11.02 至 2026.11.06 工作总结'\n# capture template styles from row 3 (first data row had styles s=3 etc.) - we deleted; use row2 header style col A? We'll apply simple styles\nfrom openpyxl.styles import Font, Alignment, Border, Side, PatternFill\nthin = Side(style='thin', color='000000')\nborder = Border(left=thin,right=thin,top=thin,bottom=thin)\ncenter = Alignment(horizontal='center', vertical='center', wrap_text=True)\nleft = Alignment(horizontal='left', vertical='center', wrap_text=True)\n\nr = 3\nfor i, e in enumerate(events, start=1):\n    vals = [i, OWNER, e['proj'], BR_T.get(e['proj'], branch_of(e['proj'])), e['zid'], e['content'],\n            e['start'], e['end'], e['hours'], e['ttype'], e['prog'], e['note']]\n    for ci, v in enumerate(vals, start=1):\n        c = ws.cell(row=r, column=ci, value=v)\n        c.border = border\n        c.font = Font(name='宋体', size=10)\n        c.alignment = left if ci in (6,12) else center\n    ws.row_dimensions[r].height = 30\n    r += 1\n\nws.column_dimensions['A'].width = 9\nws.column_dimensions['B'].width = 10\nws.column_dimensions['C'].width = 16\nws.column_dimensions['D'].width = 30\nws.column_dimensions['E'].width = 12\nws.column_dimensions['F'].width = 60\nws.column_dimensions['G'].width = 14\nws.column_dimensions['H'].width = 14\nws.column_dimensions['I'].width = 12\nws.column_dimensions['J'].width = 12\nws.column_dimensions['K'].width = 10\nws.column_dimensions['L'].width = 24\n\n# ===== Sheet 2: 下周工作计划 =====\nws2 = wb['下周工作计划']\n# inspect header: keep header, clear data\n# Determine header row: likely row2 headers, row1 title\nmaxr2 = ws2.max_row\nfor rr in range(maxr2, 2, -1):\n    ws2.delete_rows(rr)\nws2['A1'] = '研发部2026.11.09 至 2026.11.13 工作计划'\n# headers row2 (same as sheet1 columns but 预估时长)\nheaders2 = ['序号','负责人','项目名称','分支名称','禅道ID','工作内容','开始时间(yyyy/mm/dd)','结束时间(yyyy/mm/dd)','预估时长(h)','任务类型','目前进度','备注']\nfor ci,h in enumerate(headers2, start=1):\n    c=ws2.cell(row=2,column=ci,value=h); c.font=Font(name='宋体',size=10,bold=True); c.alignment=center; c.border=border\n\n# next-week planned items: carry-over in-progress items + likely continuing\nplan = [\n ('苏住房','develop/v2.6.2-suzhufang','任务1976','【前端】【苏住房小程序】迁移榆林版本的业主倡议且增加签字环节',1.5,'功能开发',0.5,'遗留，继续'),\n ('苏住房','develop/v2.6.2-suzhufang','任务2146','前端【苏住房】迁移榆林后台管理端业主倡议模块功能',2,'功能开发',0.5,'遗留，继续'),\n ('泰兴物管','develop/v2.6.2','任务2217','【前端】【泰兴物管】公共收益中增加可视化大屏统计功能',4,'功能开发',0.5,'遗留，继续'),\n ('苏州房产','develop/v3.0.0','任务-','【苏州房产】预售许可/价格备案/楼幢管理模块遗留缺陷修复',3,'BUG修复',0,'计划'),\n ('苏住房','develop/v2.6.2-suzhufang','任务-','【苏住房】首页及马上办相关体验问题优化',2,'功能开发',0,'计划'),\n]\nr2=3\nfor i,(proj,br,zid,content,h,ttype,prog,note) in enumerate(plan, start=1):\n    vals=[i,OWNER,proj,br,zid,content,'2026/11/09','2026/11/13',h,ttype,prog,note]\n    for ci,v in enumerate(vals,start=1):\n        c=ws2.cell(row=r2,column=ci,value=v); c.border=border; c.font=Font(name='宋体',size=10)\n        c.alignment= left if c