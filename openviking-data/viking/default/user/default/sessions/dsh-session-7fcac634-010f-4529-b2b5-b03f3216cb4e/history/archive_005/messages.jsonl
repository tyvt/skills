{"id": "msg_93958ca358ac445fb461ed081ae0b026", "role": "user", "parts": [{"type": "tool", "tool_id": "call_cursor_1d60eec9aa33bdf68b76de0b_1_0", "tool_name": "read", "tool_uri": "", "skill_uri": "", "tool_status": "completed", "tool_output": "[{\"type\":\"text\",\"text\":\"<path>D:\\\\repository\\\\数据湖\\\\分析产出\\\\screen_sh.py</path>\\n<type>file</type>\\n<content>\\n420:     # 不留全市场 2000 行的原因不是省事，是让这份文件能被人工过一遍——\\n421:     # 排雷看的从来不是\\\"谁过了\\\"，而是\\\"谁差一点没过、差在哪\\\"。\\n422:     det = idx[idx['①']].copy()\\n423:     det = det.assign(代码=det.code, 名称=det.name, 代码后缀=det.index)\\n424:     det = det.rename(columns={'①': '①连续分红', '②': '②股息率', '③': '③净利同比',\\n425:                               '④': '④负债率', '⑤': '⑤支付率', '⑥': '⑥现金流覆盖',\\n426:                               '⑦': '⑦ROE', '⑧': '⑧现金流净利', '⑨': '⑨12月收益',\\n427:                               '⑩': '⑩CAGR', '⑪': '⑪分红总额'})\\n428:     _cols = (['代码', '代码后缀', '名称', 'n_pass']\\n429:              + [c for c in det.columns if c.startswith(('①连续', '②股息', '③净利',\\n430:                                                         '④负债', '⑤支付', '⑥现金',\\n431:                                                         '⑦ROE', '⑧现金', '⑨12月',\\n432:                                                         '⑩CAGR', '⑪分红'))]\\n433:              + ['yld3', 'yoy3_min', 'debt', 'pay3', 'ocfd3', 'roe3', 'ocf_np3',\\n434:                 'ret12', 'div3_yi'])\\n435:     det[_cols].sort_values('n_pass', ascending=False).to_csv(\\n436:         DETAIL, index=False, encoding='utf-8-sig')\\n437:     funnel.to_csv(FUNNEL, index=False, encoding='utf-8-sig')\\n438: \\n439:     # ==================== 沪市替补席 ====================\\n440:     # 过了 11 条 + ⑫⑬⑭，且不在当前 8 只持仓里 —— 这就是明年 4 月要从中挑人的池子。\\n441:     # 排雷只做**初筛**：半年报净利同比 < −10% 或 OCF 同比 < −20% 标「需排雷」，\\n442:     # 对应《筛选标准_最终版》里人工剔除海尔/申能/海油发展的那一步。脚本不替代\\n443:     # 人工判断，只保证\\\"要看的人一眼能看到红旗\\\"，而不是等出事再回头翻财报。\\n444:     _hold = set()\\n445:     try:\\n446:         _pf = pd.read_csv('打新底仓_最终8只组合_v2.csv', encoding='utf-8-sig')\\n447:         _hold = set(_pf.loc[_pf.mkt == '沪', 'sym'])\\n448:     except Exception:\\n449:         pass\\n450: \\n451:     bench = idx[after11 & idx['阶段二'] & ~idx.index.isin(_hold)].copy()\\n452:     _h1_yoy = col('net_profit_yoy', h1).reindex(bench.index)\\n453:     _ocf_now = col('net_cash_operate', h1).reindex(bench.index)\\n454:     _ocf_pre = col('net_cash_operate', h1_prev).reindex(bench.index)\\n455:     bench['H1净利同比%'] = _h1_yoy\\n456:     bench['H1经营现金流同比%'] = (_ocf_now / _ocf_pre.where(_ocf_pre > 0) - 1) * 100\\n457:     bench['需排雷'] = np.where(\\n458:         (_h1_yoy < -10) | (bench['H1经营现金流同比%'] < -20),\\n459:         '是', '—')\\n460:     bo = bench[['code', 'name', 'board', 'industry_name', 'vol', 'yld3', 'yld_now',\\n461:                 'pay3', 'ocfd3', 'roe3', 'div3_yi', 'ret12', 'list_date',\\n462:                 'H1净利同比%', 'H1经营现金流同比%', '需排雷']].copy()\\n463:     bo.columns = ['代码', '名称', '板块', '东财行业', '年化波动%',\\n464:                   '三年平均股息率%', '当前股息率TTM%', '三年支付率%', 'OCF/分红',\\n465:                   'ROE三年均值%', '三年分红总额(亿)', '近12月收益%', '上市日期',\\n466:                   'H1净利同比%', 'H1经营现金流同比%', '需排雷']\\n467:     bo = bo.sort_values('三年平均股息率%', ascending=False).round(2)\\n468:     bo.to_csv('沪市替补席.csv', index=False, encoding='utf-8-sig')\\n469: \\n470:     print()\\n471:     print(funnel.to_string(index=False))\\n472:     print(f'\\\\n11 条全过 {len(out)} 只 → {OUT}；逐条明细 {len(det)} 行 → {DETAIL}')\\n473:     if len(out):\\n474:         show = out[['名称', '东财行业', '年化波动%', '三年平均股息率%',\\n\\n(Showing lines 420-474 of 481. Use offset=475 to continue.)\\n</content>\"}]", "tool_output_group_id": "msg_93958ca358ac445fb461ed081ae0b026", "tool_output_group_original_chars": 3286, "tool_output_group_budget_chars": 100000}], "created_at": "2026-11-11T02:02:52.102Z", "peer_id": "github.com-tyvt-financial-data-lake"}
