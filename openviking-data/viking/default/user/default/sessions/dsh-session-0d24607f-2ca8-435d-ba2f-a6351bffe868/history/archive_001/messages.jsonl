{"id": "msg_005bb2c13f7442b4bca99d29a64fd246", "role": "assistant", "parts": [{"type": "text", "text": "筛选已完成，45 条候选全文已在 select.json（content 字段即全文，body_sha 用于并发校验）。现在做关键的实机证据核对：我写一个脚本，从每条记忆正文提取可核对的代码符号（文件名/接口路径/函数名），在 D:/repository 各仓批量搜索命中证据。"}, {"type": "tool", "tool_id": "chatcmpl-tool-bb4222e19ed01d84", "tool_name": "write", "tool_uri": "", "skill_uri": "", "tool_status": "running", "tool_input": {"file_path": "C:/Users/Administrator/.dsh/cache/memory-audit/evidence_scan.py", "content": "# -*- coding: utf-8 -*-\nimport json, os, re, sys\n\nROOT = r'D:/repository'\nCACHE = r'C:/Users/Administrator/.dsh/cache/memory-audit/select.json'\nd = json.load(open(CACHE, encoding='utf-8'))\ncands = d['candidates']\n\nSKIP_DIRS = {'.git', 'node_modules', 'dist', 'build', '.venv', '__pycache__', '.idea', '.vscode', 'coverage', 'out'}\nEXTS = {'.vue', '.js', '.ts', '.jsx', '.tsx', '.mjs', '.cjs', '.py', '.scss', '.css', '.less', '.json', '.wxml', '.wxss'}\n\n# pre-scan: build list of (abs_path, rel_path, text_lower)\nfiles = []\nfor dirpath, dirnames, filenames in os.walk(ROOT):\n    dirnames[:] = [x for x in dirnames if x not in SKIP_DIRS]\n    for fn in filenames:\n        ext = os.path.splitext(fn)[1].lower()\n        if ext not in EXTS:\n            continue\n        ap = os.path.join(dirpath, fn)\n        try:\n            if os.path.getsize(ap) > 2_000_000:\n                continue\n            txt = open(ap, encoding='utf-8', errors='ignore').read()\n        except Exception:\n            continue\n        rel = os.path.relpath(ap, ROOT).replace('\\\\', '/')\n        files.append((rel, txt.lower()))\n\nsys.stderr.write('scanned files: %d\\n' % len(files))\n\nSTOP = {'false','true','null','undefined','return','created','mounted','props','data','method',\n        'watch','computed','this','class','style','width','height','color','type','value','name',\n        'list','page','add','delete','update','detail','get','post','http','request','response',\n        'success','error','default','import','export','const','let','var','function','object',\n        'string','number','boolean','array','index','form','table','dialog','button','input'}\n\ndef extract_tokens(content):\n    toks = []\n    # backtick tokens\n    for m in re.findall(r'`([^`]+)`', content):\n        toks.append(m)\n    # code-like bare identifiers\n    for m in re.findall(r'\\b([A-Za-z][A-Za-z0-9_-]{3,})\\b', content):\n        toks.append(m)\n    seen = set(); out = []\n    for t in toks:\n        t = t.strip()\n        tl = t.lower()\n        if not t or t in seen or tl in STOP:\n            continue\n        # keep: path-like, file-like, or identifier with distinctive chars\n        if ('/' in t) or re.search(r'\\.(vue|js|ts|jsx|tsx|py|scss|css|json|wxml|wxss)\\b', tl) or len(t) >= 5:\n            seen.add(t); out.append(t)\n    return out[:24]\n\nresults = []\nfor i, c in enumerate(cands, 1):\n    toks = extract_tokens(c['content'])\n    hits = {}\n    for t in toks:\n        tl = t.lower()\n        matched = []\n        for rel, txt in files:\n            if tl in txt:\n                matched.append(rel)\n                if len(matched) >= 4:\n                    break\n        if matched:\n            hits[t] = matched\n    results.append({\n        'i': i,\n        'uri': c['uri'],\n        'sha': c['body_sha256_16'],\n        'tokens': toks,\n        'hits': hits,\n    })\n\noutp = r'C:/Users/Administrator/.dsh/cache/memory-audit/evidence.json'\njson.dump(results, open(outp, 'w', encoding='utf-8'), ensure_ascii=False, indent=1)\nprint('done ->', outp)\nfor r in results:\n    print('%02d | %2d/%2d tokens hit | %s' % (r['i'], len(r['hits']), len(r['tokens']), r['uri'].split('/')[-1]))\n"}}], "created_at": "2026-11-27T10:06:51.215Z", "peer_id": "github.com-tyvt-skills"}
