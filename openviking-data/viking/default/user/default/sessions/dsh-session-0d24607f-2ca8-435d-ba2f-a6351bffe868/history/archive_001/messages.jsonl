{"id": "msg_837d181c3a8a46338a6d9b26e71c0883", "role": "assistant", "parts": [{"type": "text", "text": "宽松子串匹配（如到处命中的 `index.vue`）无法作为证据。我改用**精确锚点**：提取每条记忆里\"涉及文件\"的具体文件名与独特符号（排除 vendor/通用名），用词边界匹配，定位到确切业务仓文件。"}, {"type": "tool", "tool_id": "chatcmpl-tool-937648503f4dd02f", "tool_name": "write", "tool_uri": "", "skill_uri": "", "tool_status": "running", "tool_input": {"file_path": "C:/Users/Administrator/.dsh/cache/memory-audit/precise_scan.py", "content": "# -*- coding: utf-8 -*-\nimport json, os, re\n\nROOT = r'D:/repository'\nselect = json.load(open(r'C:/Users/Administrator/.dsh/cache/memory-audit/select.json', encoding='utf-8'))\ncands = select['candidates']\n\nEXCL = {'all','skills','OpenViking','.git'}\nSKIP = {'.git','node_modules','dist','build','.venv','__pycache__','coverage','out'}\nSRCEXT = {'.vue','.js','.ts','.jsx','.tsx','.mjs','.cjs','.py','.scss','.css','.less','.wxml','.wxss'}\n# vendor / generic basenames that prove nothing\nGENERIC = {'index.js','index.vue','index.ts','main.js','app.vue','app.js','detail.vue','list.vue',\n 'echarts.min.js','bootstrap.bundle.js','decoder.js','normalize.css','loading.vue','collapse.vue',\n 'vite.config.js','vite.config.ts','package.json','request.js','qa.js','runner.py','reporter.py',\n 'metrics.py','io.py','factor_loader.py','data_sources.py','backtest.py','config.js','utils.js',\n 'stub.js','main.ts','store.js','router.js','permission.js','settings.js','constants.js'}\n\ndef anchors(content):\n    res=[]\n    # full file basenames with source extension\n    for m in re.findall(r'([A-Za-z0-9_.-]{4,}\\.(?:vue|js|ts|jsx|tsx|py|scss|css|mjs|cjs))', content):\n        if m.lower() not in GENERIC and len(m)>11:\n            res.append(('FILE', m))\n    # distinctive camelCase / snake identifiers (length>=9)\n    for m in re.findall(r'\\b([a-z][a-zA-Z0-9]{8,}|[a-z][a-z0-9_]{9,}|[A-Z][a-zA-Z0-9]{8,})\\b', content):\n        if m.lower() in GENERIC: continue\n        res.append(('SYM', m))\n    # API paths / src paths\n    for m in re.findall(r'(/(?:api/|presale/|company/|prefund/)[A-Za-z0-9_/-{}$]+)', content):\n        res.append(('PATH', m))\n    # dedupe\n    seen=set(); out=[]\n    for k,v in res:\n        if (k,v) in seen: continue\n        seen.add((k,v)); out.append((k,v))\n    return out[:20]\n\n# index business repos\nfiles=[]\nfor repo in os.listdir(ROOT):\n    if repo in EXCL or not os.path.isdir(os.path.join(ROOT,repo)): continue\n    for dp,dn,fns in os.walk(os.path.join(ROOT,repo)):\n        dn[:] = [d for d in dn if d not in SKIP]\n        for fn in fns:\n            if os.path.splitext(fn)[1].lower() not in SRCEXT: continue\n            ap=os.path.join(dp,fn)\n            try:\n                if os.path.getsize(ap)>1_200_000: continue\n                txt=open(ap,encoding='utf-8',errors='ignore').read()\n            except Exception: continue\n            rel=os.path.relpath(ap,os.path.join(ROOT,repo)).replace('\\\\','/')\n            files.append((repo,rel,fn,txt))\n\nout=[]\nfor i,c in enumerate(cands,1):\n    an=anchors(c['content'])\n    f_hits={}  # file -> list of matched anchors\n    for repo,rel,fn,txt in files:\n        matched=[]\n        for k,v in an:\n            if k=='FILE':\n                if fn.lower()==v.lower(): matched.append(v)\n            else:\n                if re.search(r'(?<![A-Za-z0-9_])'+re.escape(v)+r'(?![A-Za-z0-9_])', txt): matched.append(v)\n        if matched:\n            f_hits[(repo,rel)]=sorted(set(matched))\n    # repos ranked by distinct anchors matched in their files\n    repos={}\n    for (repo,rel),ms in f_hits.items():\n        repos.setdefault(repo,set()).update(ms)\n    ranked=sorted(repos.items(), key=lambda kv:-len(kv[1]))\n    topfiles=sorted(f_hits.items(), key=lambda kv:-len(kv[1]))[:5]\n    out.append({'i':i,'uri':c['uri'],'sha':c['body_sha256_16'],\n        'anchors':['%s:%s'%(k,v) for k,v in an],\n        'nfiles':len(f_hits),\n        'repos':[{'repo':r,'anchors':sorted(a)} for r,a in ranked[:4]],\n        'topfiles':[{'repo':f[0],'file':f[1],'matched':m} for f,m in topfiles]})\n\njson.dump(out,open(r'C:/Users/Administrator/.dsh/cache/memory-audit/precise.json','w',encoding='utf-8'),ensure_ascii=False,indent=1)\nfor r in out:\n    rep=';'.join(x['repo']+'('+','.join(a[:18] for a in x['anchors'][:3])+')' for x in r['repos'][:2])\n    print('%02d|nf=%3d|%s|%s'%(r['i'],r['nfiles'],r['uri'].split('/')[-1][:26],rep[:150]))\n"}}], "created_at": "2026-11-27T10:11:11.057Z", "peer_id": "github.com-tyvt-skills"}
