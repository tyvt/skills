\\\" class=\\\"label-above\\\">{{ item.labelAbove }}</div>\\n29:                 <div class=\\\"detail-label-main\\\">\\n30:                   <span :title=\\\"getLabelTitle(item.label)\\\">\\n31:                     {{ formatLabel(item.label) }}\\n32:                   </span>\\n33:                 </div>\\n34:               </div>\\n35:             </div>\\n36: \\n37:             <!-- 值区域 -->\\n38:             <div\\n39:               class=\\\"value-area\\\"\\n40:               :class=\\\"{\\n41:                 'auto-height': isAutoHeightItem(item),\\n42:                 'value-area--change': hasChangeIndicator(item)\\n43:               }\\\">\\n44:               <el-tooltip\\n45:                 v-if=\\\"hasChangeIndicator(item)\\\"\\n46:                 effect=\\\"dark\\\"\\n47:                 :content=\\\"getChangeTooltip(item)\\\"\\n48:                 placement=\\\"top\\\"\\n49:                 :open-delay=\\\"200\\\">\\n50:                 <span class=\\\"cell-change-flag-hit\\\" aria-hidden=\\\"true\\\">\\n51:                   <span class=\\\"cell-change-flag\\\" />\\n52:                 </span>\\n53:               </el-tooltip>\\n54:               <div class=\\\"detail-value\\\" :class=\\\"[getValueClass(item), { 'with-button': item.buttonText }]\\\" :style=\\\"getValueStyle(item)\\\">\\n55:                 <!-- 金额类型 -->\\n56:                 <div\\n57:                   v-if=\\\"item.type === 'amount'\\\"\\n58:                   :class=\\\"['detail-text', ...getValueClass(item)]\\\"\\n59:                   :style=\\\"getValueStyle(item)\\\"\\n60:                   :title=\\\"getValueTitle(item)\\\">\\n61:                   {{ getAmountDisplay(item) }}\\n62:                 </div>\\n63: \\n64:                 <!-- 文本类型 -->\\n65:                 <div v-else-if=\\\"item.type === 'text' || !item.type\\\" class=\\\"detail-text-wrapper\\\" :class=\\\"{ 'with-button': item.buttonText }\\\">\\n66:                   <div class=\\\"detail-text\\\" :title=\\\"getValueTitle(item)\\\">\\n67:                     {{ item.value || placeholder }}\\n68:                   </div>\\n69:                   <div class=\\\"detail-text-button\\\" v-if=\\\"item.buttonText\\\" @click=\\\"handleButtonClick(item)\\\">\\n70:                     <span>{{ item.buttonText }}</span>\\n71:                   </div>\\n72:                 </div>\\n73: \\n74:                 <!-- 图片类型 -->\\n75:                 <div v-else-if=\\\"item.type === 'datetime'\\\" class=\\\"detail-text-wrapper\\\">\\n76:                   <div class=\\\"detail-text\\\" :title=\\\"getValueTitle(item)\\\">\\n77:                     {{ formatDateTime(item.value) || placeholder }}\\n78:                   </div>\\n79:                 </div>\\n80: \\n81:                 <template v-else-if=\\\"item.type === 'image'\\\">\\n82:                   <img\\n83:                     v-if=\\\"shouldRenderSingleAttachmentThumb(item.value)\\\"\\n84:                     :src=\\\"getAttachmentThumbSrc(getAttachmentFiles(item.value)[0])\\\"\\n85:                     class=\\\"detail-image\\\"\\n86:                     :title=\\\"getAttachmentFiles(item.value)[0].name\\\"\\n87:                     @click=\\\"handleAttachmentThumbClick(getAttachmentFiles(item.value)[0], item.value)\\\"\\n88:                     @error=\\\"handleAttachmentImageError(getAttachmentFiles(item.value)[0])\\\" />\\n89:                   <div v-else-if=\\\"getAttachmentFiles(item.value).length\\\" class=\\\"attachment-list\\\">\\n90:                     <div\\n91:                       v-for=\\\"(file, fileIndex) in getAttachmentFiles(item.value)\\\"\\n92:                       :key=\\\"getAttachmentKey(file, fileIndex)\\\"\\n93:                       class=\\\"attachment-item\\\">\\n94:                       <img\\n95:                         :src=\\\"getAttachmentThumbSrc(file)\\\"\\n96:                         class=\\\"attachment-image\\\"\\n97:                         :title=\\\"file.name\\\"\\n98:                         @click=\\\"handleAttachmentThumbClick(file, item.value)\\\"\\n99:                         @error=\\\"handleAttachmentImageError(file)\\\" />\\n100:                       <div class=\\\"attachment-name\\\" :title=\\\"file.name\\\">{{ file.name }}</div>\\n101:                     </div>\\n102:                   </div>\\n103:                   <span v-else>{{ placeholder }}</span>\\n104:                 </template>\\n105: \\n106:                 <!-- 图片列表 -->\\n107:                 <div v-else-if=\\\"item.type === 'images'\\\" class=\\\"image-list\\\">\\n108:                   <img\\n109:                     v-for=\\\"(img, imgIndex) in item.value\\\"\\n110:                     :key=\\\"imgIndex\\\"\\n111:                     :src=\\\"getAttachmentFullUrl(img)\\\"\\n112:                     class=\\\"image-item\\\"\\n113:                     @click=\\\"previewImages(item.value, imgIndex)\\\"/>\\n114:                 </div>\\n115: \\n116:                 <!-- 标签类型 -->\\n117:                 <div v-else-if=\\\"item.type === 'tag' || item.type === 'dict'\\\" class=\\\"tag-list\\\">\\n118:                   <dict-tag v-if=\\\"hasTagRenderableValue(item)\\\" :options=\\\"item.options\\\" :value=\\\"item.value\\\" />\\n119:                   <span v-else>{{ placeholder }}</span>\\n120:                 </div>\\n121: \\n122:                 <!-- 开关类型 -->\\n123:                 <input v-else-if=\\\"item.type === 'switch'\\\" type=\\\"checkbox\\\" :checked=\\\"item.value\\\" disabled class=\\\"detail-switch\\\" />\\n124: \\n125:                 <!-- 自定义插槽 -->\\n126:                 <slot v-else-if=\\\"item.type === 'slot'\\\" :name=\\\"item.slotName\\\" :item=\\\"item\\\"></slot>\\n127: \\n128:                 <!-- 富文本 -->\\n129:                 <div v-else-if=\\\"item.type === 'richtext'\\\" v-html=\\\"item.value\\\" class=\\\"rich-text\\\"></div>\\n130: \\n\\n(Showing lines 1-130 of 1596. Use offset=131 to continue.)\\n</content>\"}]", "tool_output_group_id": "msg_b0ddfe