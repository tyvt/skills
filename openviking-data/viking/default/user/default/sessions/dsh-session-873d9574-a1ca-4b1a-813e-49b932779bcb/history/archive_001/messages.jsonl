[\"el-radio\",\"<el-radio\",\":value\"]),\n42:(\"太仓一网通办H5\",[\"ResultStatistics.vue\",\"ResultStatisticsTab.vue\"],[\"optionGroupResultList\",\"calculationChart\",\"selectDecisionResult\"]),\n43:(\"repository\",[\"user.js\",\"stores/user\"],[\"console.log\",\"token\",\"state\"]),\n44:(\"产品2.0\",[\"OperationBtnGroup/index.vue\"],[\"OperationBtnGroup\",\"goBack\",\"go(-1)\"]),\n}\nSKIP={\"node_modules\",\"dist\",\".git\",\"report.html\",\"package-lock.json\",\"memory_diff.json\",\"memories-rebuilt.json\",\"layered-final.json\"}\ndef walk(proj):\n    base=os.path.join(ROOT,proj)\n    files=[]\n    if not os.path.isdir(base): return files\n    for dp,dn,fn in os.walk(base):\n        dn[:]=[d for d in dn if d not in SKIP]\n        for f in fn:\n            if f in SKIP or not f.lower().endswith((\".vue\",\".js\",\".ts\",\".scss\",\".json\",\".html\",\".css\",\".py\")): continue\n            p=os.path.join(dp,f)\n            try:\n                if os.path.getsize(p)>2_000_000: continue\n                files.append(p)\n            except: pass\n    return files\nout={}\nfor idx,(proj,frags,toks) in C.items():\n    files=walk(proj)\n    proj_exists=os.path.isdir(os.path.join(ROOT,proj))\n    # 缩小到声明文件\n    fc=[]\n    for f in files:\n        rel=f.replace(\"\\\\\",\"/\")\n        if not frags or any(fr.lower() in rel.lower() for fr in frags): fc.append(f)\n    hittok={}\n    for f in fc[:400]:\n        try: txt=open(f,encoding=\"utf-8\",errors=\"ignore\").read()\n        except: continue\n        for t in toks:\n            if t.lower() in txt.lower():\n                hittok.setdefault(t,[]).append(f.replace(\"\\\\\",\"/\").replace(ROOT+\"/\",\"\"))\n    ok = proj_exists and len(hittok)>0\n    out[idx]={\"proj\":proj,\"proj_exists\":proj_exists,\"file_count\":len(fc),\"tokens_hit\":{k:v[:2] for k,v in hittok.items()},\"valid\":ok}\n    print(f\"[{idx}] {proj} exists={proj_exists} files={len(fc)} {'VALID' if ok else 'INVALID'} hits={list(hittok)}\",flush=True)\njson.dump(out,open(r\"C:/Users/Administrator/.dsh/cache/memory-audit/verify.json\",\"w\",encoding=\"utf-8\"),ensure_ascii=False,indent=1)\nprint(\"DONE\")\n"}}], "created_at": "2026-11-27T05:10:54.856Z", "peer_id": "github.com-tyvt-skills"}
