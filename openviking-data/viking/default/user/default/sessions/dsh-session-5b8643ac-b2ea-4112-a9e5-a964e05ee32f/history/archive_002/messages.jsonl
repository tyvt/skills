            f\\\"ok={res.ok} cwd={new_ctx.get('cwd')}\\\"\\n247:         )\\n248:         return {\\n249:             \\\"results\\\": results,\\n250:             \\\"cursor\\\": i + 1,\\n251:             \\\"trace\\\": trace,\\n252:             \\\"environment_context\\\": new_ctx,\\n253:         }\\n254: \\n255:     def should_continue(state: OrchState) -> str:\\n256:         if state.get(\\\"cursor\\\", 0) < len(state.get(\\\"plan\\\", [])):\\n257:             return \\\"dispatch\\\"\\n258:         return \\\"summarize\\\"\\n259: \\n260:     def node_summarize(state: OrchState) -> OrchState:\\n261:         results = state.get(\\\"results\\\", [])\\n262:         if not results:\\n263:             return {\\\"final\\\": \\\"(无步骤结果)\\\"}\\n264:         if len(results) == 1 and results[0][\\\"tool\\\"] == \\\"planner\\\" and results[0][\\\"ok\\\"]:\\n265:             return {\\\"final\\\": results[0][\\\"content\\\"]}\\n266:         joined = \\\"\\\\n\\\\n\\\".join(\\n267:             f\\\"[步骤{i+1} · {r['tool']} · {r.get('model_used')}]\\\\n{r['content']}\\\"\\n268:             for i, r in enumerate(results)\\n269:         )\\n\\n(Showing lines 180-269 of 308. Use offset=270 to continue.)\\n</content>\"}]", "tool_output_group_id": "msg_74cf93e9f7de4427abc6555b2bd492d1", "tool_output_group_original_chars": 4533, "tool_output_group_budget_chars": 100000}], "created_at": "2026-11-10T02:28:13.740Z", "peer_id": "deepseek-harness-default-workspace"}
