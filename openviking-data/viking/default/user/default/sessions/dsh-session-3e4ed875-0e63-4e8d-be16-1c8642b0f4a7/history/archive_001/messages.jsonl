       },\\n114:       ],\\n115:       showPopup: false,\\n116:       errors: {\\n117:         '001': {\\n118:           type: 'error',\\n119:           msg: '合同数据不存在',\\n120:           title: '查询失败'\\n121:         },\\n122:         '002': {\\n123:           type: 'error',\\n124:           msg: '合同未备案',\\n125:           title: '查询失败'\\n126:         },\\n127:         '003': {\\n128:           type: 'error',\\n129:           msg: '合同已注销',\\n130:           title: '查询失败'\\n131:         },\\n132:         '004': {\\n133:           type: 'error',\\n134:           msg: '证件号不正确',\\n135:           title: '匹配失败'\\n136:         },\\n137:         '005': {\\n138:           type: 'error',\\n139:           msg: '未办理首次登记',\\n140:           title: '查询失败'\\n141:         },\\n142:         '006': {\\n143:           type: 'warning',\\n144:           msg: '该合同已存在交易数据，请勿重复提交！',\\n145:           title: '重复提交'\\n146:         },\\n147:         '007': {\\n148:           type: 'warning',\\n149:           msg: '该合同已存在交易数据，请勿重复提交！',\\n150:           title: '重复提交'\\n151:         },\\n152:         '008': {\\n153:           type: 'error',\\n154:           msg: '未办理交易',\\n155:           title: ''\\n156:         },\\n157:         '009': {\\n158:           type: 'warning',\\n159:           msg: '未查询到办证信息',\\n160:           title: '重复提交'\\n161:         },\\n162:         '099': {\\n163:           type: 'error',\\n164:           msg: '防伪码验证失败，请确认',\\n165:           title: '查询失败'\\n166:         },\\n167:         'ERR-1': {\\n168:           type: 'error',\\n169:           msg: '系统内部异常',\\n170:           title: '查询失败'\\n171:         },\\n172:         'ERR-2': {\\n173:           type: 'error',\\n174:           msg: '传入参数错误',\\n175:           title: '查询失败'\\n176:         },\\n177:         'ERR-3': {\\n178:           type: 'error',\\n179:           msg: '不动产接口内部错误',\\n180:           title: '查询失败'\\n181:         }\\n182:       },\\n183:       currentError: {\\n184:         type: '',\\n185:         msg: '',\\n186:         title: ''\\n187:       }\\n188:     }\\n189:   },\\n190:   onLoad(options) {\\n191:     this.form.region = options.region\\n192:     this.form.buyerName = userStore.username\\n193:     this.form.idNumber = userStore.idNumber\\n194:     this.initDict()\\n195:   },\\n196:   methods: {\\n197:     blurName,\\n198:     blurIdNumber,\\n199:     showTip() {\\n200:       this.$refs.popup.open()\\n201:     },\\n202:     async initDict() {\\n203:       // 区域字典\\n204:       await getDictV1('transaction_region').then((data) => {\\n205:         this.regionOptions = data\\n206:       })\\n207:     },\\n208:     // 立即核验\\n209:     auth() {\\n210:       this.$refs.formRef\\n211:         .validate()\\n212:         .then(() => {\\n213:           uni.showLoading({\\n214:             title: '查询中',\\n215:           })\\n216:           firstHandHouseSubmit({ ...this.form }).then((res) => {\\n217:             if (res.result.isCompleted) {\\n218:               uni.navigateTo({\\n219:                 url: '/pages_transaction/newHouseCertification/success',\\n220:               })\\n221:             } else {\\n222:               this.currentError = this.errors[res.result.code] || {\\n223:                 type: 'error',\\n224:                 msg: '系统异常,请联系管理员',\\n225:                 title: '系统错误'\\n226:               }\\n227:               this.showPopup = true\\n228:             }\\n229:           }).finally(() => {\\n230:             uni.hideLoading()\\n231:           })\\n232:         })\\n233:     }\\n234:   },\\n235: }\\n236: </script>\\n237: \\n238: <style scoped>\\n239: :deep(.uni-forms-item__label) {\\n240:   font-size: 32rpx;\\n241:   font-weight: 400;\\n242:   color: #666666;\\n243:   line-height: 44rpx;\\n244: }\\n245: \\n246: :deep(.uni-easyinput) {\\n247:   padding-left: 20rpx;\\n248: }\\n249: \\n250: :deep(.uni-easyinput__content-input),\\n251: :deep(.uni-forms-item__content) {\\n252:   font-size: 32rpx;\\n253:   font-weight: 400;\\n254:   color: #333333;\\n255:   li