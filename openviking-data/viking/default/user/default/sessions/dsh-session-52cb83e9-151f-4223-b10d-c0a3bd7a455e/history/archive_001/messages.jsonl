    dns[:] = [d for d in dns if d not in SKIP_DIRS]\n    for fn in fns:\n        if fn.lower().endswith(('.vue','.js','.ts','.tsx','.jsx','.scss','.css','.less','.json','.md','.java','.xml','.py')):\n            p = os.path.join(dp, fn)\n            try:\n                if os.path.getsize(p) > 1500000: continue\n                with open(p, encoding='utf-8', errors='ignore') as f:\n                    files.append((p, f.read()))\n            except Exception:\n                pass\n\nprint('files indexed:', len(files))\nreport = {}\nfor idx, c in enumerate(cs, 1):\n    toks = list(TOK.get(idx, []))\n    if not toks:  # auto-extract distinctive identifiers for prefs/39\n        content = c['content']\n        ids = re.findall(r'\\b[A-Z][A-Za-z0-9_]{6,}\\b', content)\n        files_in = re.findall(r'[\\w./-]+\\.(?:vue|js|ts|scss|css)', content)\n        toks = list(dict.fromkeys(files_in + ids))[:8]\n    found = {}\n    for t in toks:\n        hits = [p for p, txt in files if t in txt]\n        if hits:\n            found[t] = len(hits)\n    report[idx] = {'sha': c['body_sha256_16'], 'uri': c['uri'], 'toks': toks, 'found': found}\n\nwith open(CACHE + '/verify_report.json', 'w', encoding='utf-8') as f:\n    json.dump(report, f, ensure_ascii=False, indent=2)\n# compact print\nfor idx, r in report.items():\n    nf = len(r['found'])\n    missing = [t for t in r['toks'] if t not in r['found']]\n    print(f\"{idx:2d} found {nf}/{len(r['toks'])}  miss={missing}\")\n"}}], "created_at": "2026-11-26T09:37:08.540Z", "peer_id": "github.com-tyvt-skills"}
