[BASE_SCEN_IDX, '个股加权波动'])\"}]", "tool_output_group_id": "msg_949ffbb805c24de082022fe03eca3e6b", "tool_output_group_original_chars": 1675, "tool_output_group_budget_chars": 100000}], "created_at": "2026-11-15T02:00:52.064Z", "peer_id": "github.com-tyvt-financial-data-lake"}
