sdir(os.path.join(REPO,d)) and d not in EXCLUDE]\n# pre-index file paths\nfpaths=[]\nfor dn in dirs:\n    for r,ds,fs in os.walk(os.path.join(REPO,dn)):\n        ds[:]=[x for x in ds if x not in {\"node_modules\",\".git\",\"dist\",\"build\",\"unpackage\",\"assets\"}]\n        for f in fs:\n            if os.path.splitext(f)[1].lower() in {\".vue\",\".js\",\".ts\",\".scss\",\".css\",\".json\",\".wxml\",\".wxss\",\".mjs\",\".html\",\".env\",\".production\"}:\n                fpaths.append((dn,os.path.join(r,f)))\nout=[]\nfor label,toks in checks:\n    out.append(f\"### {label}\")\n    counts={t:0 for t in toks}; samples={t:[] for t in toks}\n    for dn,p in fpaths:\n        try: txt=open(p,encoding=\"utf-8\",errors=\"ignore\").read()\n        except: continue\n        for t in toks:\n            if t in txt:\n                counts[t]+=1\n                if len(samples[t])<2:\n                    samples[t].append(dn+\"/\"+os.path.relpath(p,os.path.join(REPO,dn)).replace(\"\\\\\",\"/\"))\n    for t in toks:\n        out.append(f\"  {t!r}: n={counts[t]} :: {', '.join(samples[t])}\")\n    out.append(\"\")\nopen(OUT,\"w\",encoding=\"utf-8\").write(\"\\n\".join(out))\nprint(\"wrote\",OUT,\"files scanned\",len(fpaths))\n"}}], "created_at": "2026-11-26T21:10:19.510Z", "peer_id": "github.com-tyvt-skills"}
