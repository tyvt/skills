{"id": "msg_9ef3a783f7644f41a3b03a69ddb1d33c", "role": "assistant", "parts": [{"type": "text", "text": "The basename evidence is noisy because generic filenames match across repos. Let me build a targeted verifier that restricts grep to each memory's named project repo and checks distinctive tokens (functions, API paths, CSS values, fields)."}, {"type": "tool", "tool_id": "chatcmpl-tool-b31eaed1240ccb60", "tool_name": "write", "tool_uri": "", "skill_uri": "", "tool_status": "running", "tool_input": {"file_path": "C:/Users/Administrator/.dsh/cache/memory-audit/verify.py", "content": "import json, os, re\n\nSEL = \"C:/Users/Administrator/.dsh/cache/memory-audit/select.json\"\nOUT = \"C:/Users/Administrator/.dsh/cache/memory-audit/verify.txt\"\nREPO = \"D:/repository\"\n\nd = json.load(open(SEL, encoding=\"utf-8\"))\ncands = d[\"candidates\"]\n\n# map project name -> repo dir\ndirs = [x for x in os.listdir(REPO) if os.path.isdir(os.path.join(REPO, x))]\n\ndef find_repo(project):\n    if not project:\n        return None\n    # exact / contained match\n    for dname in dirs:\n        if project == dname or project in dname or dname in project:\n            return os.path.join(REPO, dname)\n    return None\n\ndef extract_project(content):\n    pats = [\n        r\"所属项目[：:]\\s*([^\\s；;，,。]+)\",\n        r\"project=([^\\s；;，,。]+)\",\n        r\"所属项目[：:]\\s*([^\\s]+)\",\n    ]\n    for p in pats:\n        m = re.search(p, content)\n        if m:\n            return m.group(1).strip()\n    return None\n\ndef distinctive_tokens(content):\n    toks = set()\n    # camelCase function/identifier names len>=6\n    for m in re.findall(r\"\\b[a-zA-Z][a-zA-Z0-9]{5,30}\\b\", content):\n        if m[0].isupper() or any(c.isupper() for c in m[1:]):\n            toks.add(m)\n    # snake_case names\n    for m in re.findall(r\"\\b[a-z][a-z0-9_]{5,30}\\b\", content):\n        if \"_\" in m:\n            toks.add(m)\n    # API paths\n    for m in re.findall(r\"/[a-zA-Z][\\w/]{4,60}\", content):\n        toks.add(m)\n    # css values distinctive\n    for m in re.findall(r\"(?:flex\\s*:\\s*[\\d\\s\\w]+|white-space\\s*:\\s*nowrap|aspectFit|aspectFill|75vh|word-break\\s*:\\s*keep-all)\", content):\n        toks.add(m.strip())\n    # filter noisy\n    stop = {\"extracted\",\"source\",\"cursor\",\"project\",\"session\",\"baseline\",\"github\",\"http\",\"https\",\"undefined\",\"computed\",\"component\",\"components\",\"methods\",\"requires\",\"import\",\"default\",\"return\",\"function\",\"verification\",\"evidence\",\"batch\",\"标记\",\"needs\"}\n    toks = {t for t in toks if t.lower() not in stop and len(t) >= 6}\n    return sorted(toks, key=lambda x: -len(x))[:18]\n\ndef grep_repo(repo, token):\n    hits = 0\n    sample = \"\"\n    for root, ds, fs in os.walk(repo):\n        ds[:] = [x for x in ds if x not in {\"node_modules\",\".git\",\"dist\",\"build\",\"unpackage\"}]\n        for f in fs:\n            if os.path.splitext(f)[1].lower() not in {\".vue\",\".js\",\".ts\",\".scss\",\".css\",\".json\",\".wxml\",\".wxss\",\".mjs\"}:\n                continue\n            try:\n                txt = open(os.path.join(root, f), encoding=\"utf-8\", errors=\"ignore\").read()\n            except Exception:\n                continue\n            if token in txt:\n                hits += 1\n                if not sample:\n                    sample = os.path.relpath(os.path.join(root, f), repo).replace(\"\\\\\",\"/\")\n    return hits, sample\n\nlines = []\nfor i, c in enumerate(cands):\n    content = c[\"content\"]\n    project = extract_project(content)\n    repo = find_repo(project)\n    toks = distinctive_tokens(content)\n    lines.append(f\"[{i:02d}] sha={c['body_sha256_16']} project={project} repo={os.path.basename(repo) if repo else 'NONE'}\")\n    # summary snippet\n    snip = re.sub(r\"\\s+\",\" \",content)[:280]\n    lines.append(\"  S: \"+snip)\n    if repo and toks:\n        for t in toks:\n            h, s = grep_repo(repo, t)\n            lines.append(f\"  G {t!r}: hits={h} sample={s}\")\n    elif not repo:\n        lines.append(\"  NO_REPO_MATCH\")\n    lines.append(\"\")\n\nopen(OUT,\"w\",encoding=\"utf-8\").write(\"\\n\".join(lines))\nprint(\"wrote\", OUT, \"lines\", len(lines))\n"}}], "created_at": "2026-11-26T21:05:47.529Z", "peer_id": "github.com-tyvt-skills"}
