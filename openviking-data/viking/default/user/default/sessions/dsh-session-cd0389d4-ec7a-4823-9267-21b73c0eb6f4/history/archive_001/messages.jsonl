{"id": "msg_93b119eccac244418fca044bfc4d5b5d", "role": "assistant", "parts": [{"type": "text", "text": "需要按\"记忆声明的项目仓库\"做精确核对（此前 probe 跨仓拼接会误判）。写一次精炼核对脚本：项目名→仓库映射，只在该仓内查专属锚点。"}, {"type": "tool", "tool_id": "chatcmpl-tool-857f47ed9e462854", "tool_name": "write", "tool_uri": "", "skill_uri": "", "tool_status": "running", "tool_input": {"file_path": "C:/Users/Administrator/.dsh/cache/memory-audit/probe3.py", "content": "# -*- coding: utf-8 -*-\nimport json, os, re\nfrom pathlib import Path\n\nCACHE = Path(r'C:/Users/Administrator/.dsh/cache/memory-audit')\nd = json.loads((CACHE/'select.json').read_text(encoding='utf-8'))\nROOT = Path('D:/repository')\ndirs = [p.name for p in ROOT.iterdir() if p.is_dir()]\n\n# 项目名 -> 候选仓库目录名(按优先级)\nREPO_MAP = {\n '无锡市区小程序嵌入H5':['无锡市区小程序嵌入H5'],\n '苏住房C':['苏住房C'],\n '苏住房G':['苏住房G'],\n '产品2.0':['产品2.0'],\n '门户':['门户'],\n '园区物管2.0':['园区物管2.0'],\n '园区公共收益':['园区公共收益'],\n '泰兴小程序':['泰兴小程序'],\n '苏州市房地产监测V3':['苏州市房地产监测V3'],\n '太仓G':['太仓G'],\n '相城G':['相城G'],\n '淮安物管':['淮安物管'],\n '2-0':['园区物管2.0','产品2.0'],\n 'repository':[],\n}\n\ndef pick_repo(proj):\n    for key,vals in REPO_MAP.items():\n        if key and key in proj:\n            for v in vals:\n                if v in dirs:\n                    return v\n    return None\n\nSTOP = {'function','return','const','this','string','number','project','source','extracted',\n        'session','vue','true','false','undefined','component','components','methods','computed',\n        'file','files','path','data','type','value','index','detail','src','views','pages',\n        'util','utils','api','build','dist','name','version','default','include','exclude',\n        'import','export','interface','warning','message','success','error','repository',\n        'property','template','required','trigger','rules','company','autonomy','disabled'}\n\ndef anchors_of(content):\n    a=[]\n    for m in re.findall(r'/[a-zA-Z][\\w/\\-]{6,}', content): a.append(m.strip('/'))\n    for m in re.findall(r'`([^`\\n]{3,40})`', content):\n        if re.search(r'[A-Za-z]{3}', m): a.append(m)\n    for m in re.findall(r'\\b[a-zA-Z][a-zA-Z0-9]{6,}\\b', content):\n        if m.lower() not in STOP: a.append(m)\n    seen=set(); out=[]\n    for x in a:\n        if x not in seen: seen.add(x); out.append(x)\n    return out\n\nSKIP={'node_modules','dist','.git','.idea','.vscode','build','coverage','.nuxt','target'}\nEXT={'.vue','.js','.ts','.mjs','.scss','.css','.jsx','.tsx'}\n\ndef repo_blob(repo):\n    rp=ROOT/repo\n    parts=[]\n    for dp,dn,fn in os.walk(rp):\n        dn[:]=[x for x in dn if x not in SKIP]\n        for f in fn:\n            if Path(f).suffix in EXT:\n                try: parts.append(Path(dp+f).read_text(encoding='utf-8',errors='ignore'))\n                except: pass\n    return '\\n'.join(parts)\n\ncache={}\nlines=[]\nfor i,c in enumerate(d['candidates'],1):\n    content=c['content']\n    projm=re.search(r'所属项目[：:]\\s*([^；;\\n]+)', content)\n    proj=projm.group(1).strip() if projm else ''\n    repo=pick_repo(proj)\n    anch=anchors_of(content)[:10]\n    hits=[]\n    if repo:\n        if repo not in cache: cache[repo]=repo_blob(repo)\n        blob=cache[repo]\n        hits=[a for a in anch if a and a in blob]\n    lines.append(f'[{i}] {c[\"uri\"].split(\"/\")[-1]} | repo={repo} | proj={proj[:30]}')\n    lines.append(f'    anchors={anch}')\n    lines.append(f'    HITS={hits}')\n\n(CACHE/'audit_probe3.txt').write_text('\\n'.join(lines),encoding='utf-8')\nprint('done', len(d['candidates']))\n"}}], "created_at": "2026-11-26T15:08:27.950Z", "peer_id": "github.com-tyvt-skills"}
