ot in STOP:\n            a.append(m)\n    seen=set(); out=[]\n    for x in a:\n        if x not in seen:\n            seen.add(x); out.append(x)\n    return out[:8]\n\nlines = [f'# indexed_files={file_count}, indexed_names={len(name_index)}']\nfor i,c in enumerate(d['candidates'],1):\n    content = c['content']\n    bns = set(re.findall(r'[\\w\\-.]+\\.(?:vue|js|ts|mjs|scss)', content))\n    bns = {Path(x).name for x in bns}\n    matched = []\n    for bn in bns:\n        matched.extend(name_index.get(bn, []))\n    matched = list(dict.fromkeys(matched))[:12]\n    anch = anchors_of(content)\n    blob = ''\n    for p in matched:\n        try:\n            blob += Path(p).read_text(encoding='utf-8', errors='ignore')\n        except Exception:\n            pass\n    hits = [a for a in anch if a and a in blob]\n    lines.append(f'[{i}] {c[\"uri\"].split(\"/\")[-1]} | sha={c[\"body_sha256_16\"]}')\n    lines.append(f'    bns={sorted(bns)}')\n    lines.append(f'    files={len(matched)} sample={[Path(p).parent.name+\"/\"+Path(p).name for p in matched[:4]]}')\n    lines.append(f'    anchors={anch}')\n    lines.append(f'    HITS={hits}')\n\n(CACHE/'audit_probe.txt').write_text('\\n'.join(lines), encoding='utf-8')\nprint('done', file_count, len(name_index))\n"}}], "created_at": "2026-11-26T15:07:00.439Z", "peer_id": "github.com-tyvt-skills"}
