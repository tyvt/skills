f x not in seen:\n            seen.add(x); out.append(x)\n    return out[:10]\n\ndef match_files(content):\n    \"\"\"提取含 / 的源码路径 token，用后2-4段做后缀匹配；纯文件名用精确 basename 匹配(限量)。\"\"\"\n    toks = re.findall(r'[\\w\\-./]+\\.(?:vue|js|ts|mjs|scss|css)', content)\n    hits = []\n    for t in toks:\n        t = t.replace('\\\\','/').lstrip('./')\n        segs = [s for s in t.split('/') if s]\n        if len(segs) >= 2:\n            n = min(4, len(segs))\n            suffix = '/'.join(segs[-n:])\n            for p in all_paths:\n                if p.endswith(suffix):\n                    hits.append(p)\n        else:\n            bn = segs[0] if segs else t\n            cnt = 0\n            for p in all_paths:\n                if p.rsplit('/',1)[-1] == bn:\n                    hits.append(p); cnt += 1\n                    if cnt >= 20:\n                        break\n    # 去重，优先路径段匹配长的\n    seen=set(); out=[]\n    for p in hits:\n        if p not in seen:\n            seen.add(p); out.append(p)\n    return out[:20]\n\nlines = [f'# all_paths={len(all_paths)}']\nfor i,c in enumerate(d['candidates'],1):\n    content = c['content']\n    files = match_files(content)\n    anch = anchors_of(content)\n    blob = ''\n    for p in files:\n        try:\n            blob += Path(p).read_text(encoding='utf-8', errors='ignore')\n        except Exception:\n            pass\n    hits = [a for a in anch if a and a in blob]\n    # 项目归属关键词\n    projm = re.search(r'所属项目[：:]\\s*([^；;\\n]+)', content)\n    proj = projm.group(1).strip() if projm else ''\n    lines.append(f'[{i}] {c[\"uri\"].split(\"/\")[-1]} | sha={c[\"body_sha256_16\"]}')\n    lines.append(f'    proj={proj}')\n    lines.append(f'    files={len(files)} sample={[p.replace(\"D:/repository/\",\"\") for p in files[:5]]}')\n    lines.append(f'    anchors={anch}')\n    lines.append(f'    HITS={hits}')\n\n(CACHE/'audit_probe2.txt').write_text('\\n'.join(lines), encoding='utf-8')\nprint('done', len(all_paths))\n"}}], "created_at": "2026-11