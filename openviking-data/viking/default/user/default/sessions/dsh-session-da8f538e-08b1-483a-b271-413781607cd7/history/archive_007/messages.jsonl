{"id": "msg_c4730a73d0b04400a51081e88e08b5d5", "role": "assistant", "parts": [{"type": "text", "text": "全量完成（210 rows, DONE）。现在评分汇总 6 模型 × 35 题。"}, {"type": "tool", "tool_id": "call_00_3cMdIwuA6xGOOS30Pp9A4741", "tool_name": "write", "tool_uri": "", "skill_uri": "", "tool_status": "running", "tool_input": {"content": "import json, re, os, statistics\nBASE=r'D:\\repository\\skills\\controller-bench'\nd=json.load(open(os.path.join(BASE,'tasks-master.json'),encoding='utf-8'))\ntm={t['id']:t for t in d['tasks']}\nrows=json.load(open(os.path.join(BASE,'results','bench-workbuddy-final.json'),encoding='utf-8'))['rows']\ndef cat(tid):\n    if tid.startswith('T'): return 'T'\n    p=tid.split('-')[0]\n    return p\ndef score(r):\n    t=tm.get(r['task'])\n    if not t: return None\n    if r.get('error'): return {'st':'err'}\n    try: p=json.loads(r['raw'])\n    except: return {'st':'fmt'}\n    if not p or not p.get('route'): return {'st':'fmt'}\n    steps=[s for s in (p.get('steps') or []) if s.get('tool')]\n    routeS=1.0 if p['route']==t['route_expect'] else 0.0\n    if t['route_expect']!='execute_tools': toolS=1.0 if len(steps)==0 else 0.0\n    elif steps:\n        s=0.0\n        for st in steps:\n            if st['tool'] in t['optimal_tools']: s+=1.0\n            elif st['tool'] in t.get('acceptable_tools',[]): s+=0.6\n        toolS=s/len(steps)\n    else: toolS=0.0\n    text=' '.join([p.get('analysis') or '']+[st.get('intent','') for st in steps]+[p.get('notes') or ''])\n    hit=sum(1 for pat in t['required'] if re.search(pat,text)); comp=hit/len(t['required']) if t['required'] else 1.0\n    if t['route_expect']!='execute_tools': eff=1.0\n    elif steps: eff=min(1.0,t['optimal_steps']/len(steps))\n    else: eff=0.0\n    tot=round(0.35*toolS+0.25*comp+0.25*routeS+0.15*eff,3)\n    return {'st':'ok','tot':tot,'tool':toolS,'comp':comp,'route':routeS,'eff':eff,'steps':len(steps),'cat':cat(r['task']),'ms':r['ms']}\nres={}\nfor r in rows: res.setdefault(r['model'],[]).append(score(r))\nprint(\"=== 总分排名（35题） ===\")\nsummary=[]\nfor m,v in res.items():\n    ok=[x for x in v if x['st']=='ok']\n    fmt=sum(1 for x in v if x['st']=='fmt'); err=sum(1 for x in v if x['st']=='err')\n    avg=round(sum(x['tot'] for x in ok)/len(ok),3) if ok else 0\n    tool=round(sum(x['tool'] for x in ok)/len(ok),2) if ok else 0\n    route=round(sum(x['route'] for x in ok)/len(ok),2) if ok else 0\n    mss=[r['ms'] for r in rows if r['model']==m and not r.get('error') and 'ms' in r]\n    med=int(statistics.median(mss)) if mss else 0\n    summary.append((m,avg,fmt,err,tool,route,med))\nsummary.sort(key=lambda z:-z[1])\nprint(f\"{'model':30}{'avg':7}{'fmt':5}{'err':5}{'tool':6}{'route':7}{'ms中位':7}\")\nfor m,avg,fmt,err,tool,route,med in summary:\n    print(f\"{m:30}{avg:<7}{fmt:<5}{err:<5}{tool:<6}{route:<7}{med:<7}\")\n\nprint(\"\\n=== 按题型类别 avg（每模型） ===\")\ncats=['M1','M2','M3','M4','M5','T','M6','M7','M8','M9','M10']\nhdr='model'.ljust(30)+''.join(c.ljust(7) for c in cats)\nprint(hdr)\nfor m,_,_,_,_,_,_ in summary:\n    v=res[m]\n    line=m.ljust(30)\n    for c in cats:\n        cc=[x['tot'] for x in v if x['st']=='ok' and x.get('cat')==c]\n        line+= (f\"{round(sum(cc)/len(cc),2):<7}\" if cc else '-'.ljust(7))\n    print(line)\n", "file_path": "D:\\repository\\skills\\.task-state\\score_workbuddy_final.py"}}], "created_at": "2026-11-14T05:08:33.407Z", "peer_id": "github.com-tyvt-skills"}
