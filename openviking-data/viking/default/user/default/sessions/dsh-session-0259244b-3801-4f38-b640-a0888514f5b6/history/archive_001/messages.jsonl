\n290 |         finally:\n291 |             try:\n292 |                 os.unlink(tmp)\n293 |             except OSError:\n294 |                 pass\n295 | \n296 |     print(json.dumps({\"applied\": applied, \"skipped\": skipped, \"invalid\": invalid, \"dry_run\": args.dry_run}, ensure_ascii=False, indent=2))\n297 | \n298 | \n299 | def audit_event(uri, action, verdict, note):\n300 |     ensure_cache()\n301 |     rec = {\"at\": now_iso(), \"uri\": uri, \"action\": action, \"verdict\": verdict, \"note\": note[:300]}\n302 |     with AUDIT_LOG.open(\"a\", encoding=\"utf-8\") as f:\n303 |         f.write(json.dumps(rec, ensure_ascii=False) + \"\\\\n\")\n304 | \n305 | \n306 | def cmd_stats(args):\n307 |     uris = list_all_uris()\n308 |     counts = {\"valid\": 0, \"invalid\": 0, \"unchecked\": 0, \"invalid_date\": 0}\n309 |     # 一次 grep 取全库 audit_status, 避免对 6000+ 条逐条 read 超时.\n310 |     g = ov_json([\"grep\", \"audit_status:\", \"-u\", MEM_ROOT, \"-n\", \"20000\"])\n311 |     status_map = {}\n312 |     if g and g.get(\"ok\"):\n313 |         for mt in g.get(\"result\", {}).get(\"matches\", []):\n314 |             c = mt.get(\"content\", \"\")\n315 |             if \"audit_status:\" in c:\n316 |                 status_map[mt.get(\"uri\", \"\")] = c.split(\"audit_status:\", 1)[1].strip()\n317 |     for u in uris:\n318 |         status = status_map.get(u, \"\")\n319 |         if status in counts:\n320 |             counts[status] += 1\n321 |         else:\n322 |             counts[\"unchecked\"] += 1\n323 |     checked = counts[\"valid\"] + counts[\"invalid\"]\n324 |     print(json.dumps({\n325 |         \"total\": len(uris),\n326 |         \"checked\": checked,\n327 |         \"coverage_pct\": round(checked * 100.0 / len(uris), 1) if uris else 0,\n328 |         \"breakdown\": counts,\n329 |     }, ensure_ascii=False, indent=2))\n330 | \n331 | \n332 | def main():\n333 |     # 强制 stdout UTF-8, 防止 Windows 控制台 GBK 把中文 URI 变成乱码\n334 |     try:\n335 |         sys.stdout.reconf